          "expr": "histogram_quantile(0.5, sum by (le) (rate(fleetscope_commit_latency_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fleetscope_commit_latency_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
