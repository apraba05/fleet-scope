          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Chunks by outcome / s",
      "description": "accepted, duplicate (dedup), dlq (undecodable / bad header / expired)",
